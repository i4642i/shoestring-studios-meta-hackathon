{
  "bounds": {
    "max_steps": 8
  },
  "done": [
    "every part has >=1 real case with >=1 cited claim",
    "every claim cites a verbatim passage",
    "report picks match this run's picks"
  ],
  "flow": {
    "inputs": [
      {"category": "concept", "required": true,
       "description": "Video concept: theme, question, takeaway, intent."},
      {"category": "structure", "required": true, "accept": [2],
       "description": "Structure map: parts to find cases for, in order."},
      {"category": "source", "required": true,
       "description": "Source PC pointer for the entry to illustrate."}
    ],
    "outputs": [
      {"category": "cases",
       "description": "Case research report per part."}
    ]
  },
  "frame_version": 1,
  "id": "case_rex",
  "io": {
    "inputs": [
      "brief.json",
      "INPUTS.md"
    ],
    "output": "result.json"
  },
  "model": "meta-models/muse-spark-open-1026",
  "name": "Rex",
  "title": "Case researcher",
  "stage": 2,
  "tools": [
    "query_graph",
    "read_md_section",
    "pc_list_source",
    "pc_read_source",
    "open_ref",
    "pc_search_articles",
    "pc_pick_article",
    "pc_read_article",
    "write_cases",
    "research_status"
  ]
}
