# Copy to .env and fill in. Never commit .env.
# LLM for every worker (project.json adapters.llm; OpenAI-compatible server, base_url in project.json):
LOCAL_LLM_API_KEY=
# Optional: LAN embedding server (project.json adapters.embed.jetson; the default "cpu" needs no key):
EMBED_TOKEN=
# Meta Model API: Gene's pictures (tools/generate_image.py, muse-image-1.0):
MODEL_API_KEY=
# Optional: paid spare voice (fal.ai MiniMax, functions/_common.py; the narrator uses Kokoro, no key):
FAL_KEY=
# Photo search for Pia (tools/google_image_search.py): Serper, or Google Custom Search
SERPER_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
# Web research (tools/news_search.py):
TAVILY_API_KEY=
