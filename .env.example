# Copy to .env and fill in. Never commit .env.
# LLM key (Baseten default, else Meta Model API):
BASETEN_API_KEY=
MODEL_API_KEY=
# Embedding profile: jetson (LAN server, default) or local (this PC):
EMBED_PROFILE=jetson
# Jetson embed server (profile jetson only):
JETSON_EMBED_URL=http://192.168.0.4:8790
EMBED_REMOTE_TOKEN=
